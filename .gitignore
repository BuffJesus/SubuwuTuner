# Build outputs
build/
out/
cmake-build-*/
_deps/

# CMake cache
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
CTestTestfile.cmake
cmake_install.cmake
install_manifest.txt
compile_commands.json

# vcpkg (we'll add manifest mode later)
vcpkg_installed/

# IDEs
.vs/
.vscode/
.claude/
*.user
*.suo
*.sdf
*.opensdf

# JetBrains: ignore the per-user/per-machine bits of .idea/ but keep shared
# run configurations and the inner .gitignore so collaborators inherit them.
.idea/*
!.idea/runConfigurations/
!.idea/runConfigurations/**
!.idea/.gitignore

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# ImGui per-user window layout, regenerated at runtime
imgui.ini

# Test artifacts
Testing/
*.gcda
*.gcno
coverage/

# User-private fixtures (never commit these)
Definitions-*.atlas
fixtures/roms/
fixtures/private/

# Unrelated third-party material that lives next to the workspace
atlas-public-main/

# Binaries / packages we don't track
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.o
*.obj
*.pdb
*.exp
*.ilk

# Generated docs
site/
docs-build/

# Python caches (defgen tool)
__pycache__/
*.py[cod]
.pytest_cache/
