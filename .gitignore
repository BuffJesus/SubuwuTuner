# Build outputs
build/
out/
cmake-build-*/
_deps/

# CMake cache
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
CTestTestfile.cmake
cmake_install.cmake
install_manifest.txt
compile_commands.json

# vcpkg (we'll add manifest mode later)
vcpkg_installed/

# IDEs
.vs/
.vscode/
.claude/*
!.claude/HANDOFF.md
*.user
*.suo
*.sdf
*.opensdf

# JetBrains: ignore the per-user/per-machine bits of .idea/ but keep shared
# run configurations and the inner .gitignore so collaborators inherit them.
.idea/*
!.idea/runConfigurations/
!.idea/runConfigurations/**
!.idea/.gitignore

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# ImGui per-user window layout, regenerated at runtime
imgui.ini

# Bundled font TTFs: keep the assets/fonts/ directory tracked (via .gitkeep)
# but ignore the binary font files themselves. Drop OFL-licensed Inter +
# JetBrains Mono in here for the polished look; the font probe picks them up.
assets/fonts/*.ttf
assets/fonts/*.otf
!assets/fonts/.gitkeep

# Test artifacts
Testing/
*.gcda
*.gcno
coverage/

# User-private fixtures (never commit these). Real ROM dumps,
# captured traces, ECU-bound binaries — anything that's
# calibration data or copyrighted content sits under
# fixtures/roms/ or fixtures/private/ and is gitignored.
# Convention is documented in `tests/private/README.md` and
# `docs/01-reverse-engineering.md`.
Definitions-*.atlas
fixtures/roms/
fixtures/private/

# Private integration tests — same shape as fixtures/private/.
# Source files dropped here are gitignored so individual
# developers can stage tests against their local ROM dumps
# without those tests leaking into the public CI. The README
# + example template ARE tracked.
tests/private/*
!tests/private/README.md
!tests/private/example_private_test.cpp.template

# Path B distribution posture. VA/VB definition packs were moved out of
# this repo so the public release ships infrastructure only; users supply
# their own definitions at install/runtime. Master copy lives off-repo
# (analyst-side, private). See SubuwuTuner-specs/AUDIT.md (2026-05-14)
# and path-b-implementation-checklist.md for the rationale.
definitions/va/
definitions/vb/

# Clean-room defenses (see docs/15-clean-room-engineering.md §6).
# The wall lives in process discipline; these patterns are the safety
# net for when a protected reference ends up inside the working tree
# by accident — drag-and-drop, symlink, stray copy.

# Atlas mirror (GitHub). Canonical orientation read is the README +
# LICENSE only; the rest is All-Rights-Reserved.
atlas-public-main/

# Decompiled Atlas Java source (jd-gui dump). Canonical off-repo path
# is C:\Users\Cornelio\Desktop\jd-gui-master\atlas-decompiled\.
atlas-decompiled/
*-decompiled/

# Raw RomRaider XML and the analyst-side scrubber workspace. Canonical
# off-repo path is D:\Documents\atlas-personal\. The scrubbed
# `*.facts.xml` and `*.name-mapping.tsv` derivatives are wall-clean
# inputs to defgen, but they live analyst-side too — never in this repo.
atlas-personal/
romraider_*.xml
*.facts.xml
*.name-mapping.tsv

# Analyst working notes and the analyst-side specs repo. The kickoff
# brief at docs/analyst-mode-prompt.md steers output to
# D:\Documents\atlas-personal\analyst-notes\ and
# D:\Documents\SubuwuTuner-specs\; ignore both shapes here too in case
# someone nests them inside the workspace.
analyst-notes/
SubuwuTuner-specs/

# Binaries / packages we don't track
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.o
*.obj
*.pdb
*.exp
*.ilk

# Generated docs
site/
docs-build/

# Python caches (defgen tool)
__pycache__/
*.py[cod]
.pytest_cache/

# Personal laptop quick-reference (Syncthing-mirrored to laptop's
# C:\Users\Cornelio\Desktop\Subuwu\Tools\). User-specific paths; not
# for the public repo.
tools/LAPTOP-COMMANDS.txt
tools/STOCK-VALIDATION-FLOW.txt

# Syncthing folder markers (per-folder safety check, not source).
.stfolder/

# Per-platform definition archives produced by tools/build_definition_archives.py.
# Sources are the loose `definitions/<platform>/*.toml` files; archives are
# derived install artifacts shipped to end users (~6 MB total vs ~71 MB loose).
definitions/_archives/
