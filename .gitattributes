# Normalize line endings
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Treat these as binary
*.atlas binary
*.acf binary
*.aproj binary
*.bin binary
*.png binary
*.jpg binary
*.ico binary

# Linguist hints
docs/* linguist-documentation
atlas-public-main/* linguist-vendored
