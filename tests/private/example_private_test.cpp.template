#include <catch2/catch_test_macros.hpp>

#include "st/rom.hpp"
#include "st/defs.hpp"

#include <filesystem>

// All paths are relative to the build's working directory, which
// the test harness runs from the repo root. Adjust if you run
// the tests from a different cwd.
namespace {
std::filesystem::path const kRomPath{
    "fixtures/private/AS80U_aw0123_stock.bin"};
}

TEST_CASE("private: AS80U stock ROM loads cleanly with expected size",
          "[private][rom][va]") {
    if (!std::filesystem::exists(kRomPath)) {
        SKIP("Stage " + kRomPath.string() + " in fixtures/private/ "
             "and add an entry to PROVENANCE.toml. This test stays "
             "dormant until then.");
    }
    auto const rom = st::Rom::from_file(kRomPath);
    REQUIRE(rom.has_value());
    // VA WRX ROM size convention. Adjust if your dump differs —
    // some early VA + late VB ROMs are different sizes.
    REQUIRE(rom->size() == 1572864);
}

TEST_CASE("private: AS80U ROM CID matches what the pack identifies",
          "[private][rom][va]") {
    if (!std::filesystem::exists(kRomPath)) {
        SKIP("Stage " + kRomPath.string());
    }
    auto rom = st::Rom::from_file(kRomPath);
    REQUIRE(rom.has_value());

    // CID lives at byte offset 0x00002000 per Subaru convention
    // (see docs in 58a821f). 8 chars, ASCII, trailing spaces
    // are real.
    auto const cid_span = std::span<std::uint8_t const>{
        rom->bytes().data() + 0x2000, 8};
    std::string const cid{cid_span.begin(), cid_span.end()};
    REQUIRE(cid == "AS80U   ");
}

