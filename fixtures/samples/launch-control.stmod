# Launch-control sample feature — third illustrative starter for the
# custom-features designer.
#
# What it does: arms an ignition cut while the driver is staged for
# a launch — clutch held, throttle pinned (> 95%), vehicle stopped
# or rolling slowly (< 10 km/h), and engine RPM above the launch
# target (> 4500 rpm). When all four conditions are true, ignition
# is cut to clip RPM back below the target. The cut releases the
# moment any condition drops.
#
# Pairs with fixtures/demo-pack — load that pack first, then open
# this file via the designer's Load… button. Right-click any of the
# threshold pins to retune the constants (95 / 10 / 4500).
#
# Caveat: real launch control adds gear detection, debounce, and a
# trans-brake-friendly anti-stall floor — none of that ships here.
# This is the smallest graph that demonstrates the AND-tree pattern
# common to most stage-arming features.

[graph]
schema_version = 1

# ---- Sensor reads --------------------------------------------------

[[node]]
id    = 1
kind  = "hook.clutch_switch"
label = "Clutch switch"
x     = 48.0
y     = 48.0
phase_break = true
pins  = [
  { id = 0, name = "Pressed", type = "bool", direction = "output", unit = "" }
]

[[node]]
id    = 2
kind  = "hook.read_throttle_pct"
label = "Throttle position"
x     = 48.0
y     = 168.0
phase_break = true
pins  = [
  { id = 0, name = "Throttle %", type = "float", direction = "output", unit = "%" }
]

[[node]]
id    = 3
kind  = "hook.read_vehicle_speed"
label = "Vehicle speed"
x     = 48.0
y     = 288.0
phase_break = true
pins  = [
  { id = 0, name = "Speed", type = "float", direction = "output", unit = "km/h" }
]

[[node]]
id    = 4
kind  = "hook.read_rpm"
label = "Engine RPM"
x     = 48.0
y     = 408.0
phase_break = true
pins  = [
  { id = 0, name = "RPM", type = "float", direction = "output", unit = "rpm" }
]

# ---- Threshold checks --------------------------------------------

[[node]]
id    = 5
kind  = "primitive.compare_gt_float"
label = "throttle > 95"
x     = 312.0
y     = 168.0
pins  = [
  { id = 0, name = "a",     type = "float", direction = "input",  unit = "" },
  { id = 1, name = "b",     type = "float", direction = "input",  unit = "", default = 95.0 },
  { id = 2, name = "a > b", type = "bool",  direction = "output", unit = "" }
]

[[node]]
id    = 6
kind  = "primitive.compare_lt_float"
label = "speed < 10"
x     = 312.0
y     = 288.0
pins  = [
  { id = 0, name = "a",     type = "float", direction = "input",  unit = "" },
  { id = 1, name = "b",     type = "float", direction = "input",  unit = "", default = 10.0 },
  { id = 2, name = "a < b", type = "bool",  direction = "output", unit = "" }
]

[[node]]
id    = 7
kind  = "primitive.compare_gt_float"
label = "rpm > 4500"
x     = 312.0
y     = 408.0
pins  = [
  { id = 0, name = "a",     type = "float", direction = "input",  unit = "" },
  { id = 1, name = "b",     type = "float", direction = "input",  unit = "", default = 4500.0 },
  { id = 2, name = "a > b", type = "bool",  direction = "output", unit = "" }
]

# ---- AND tree ----------------------------------------------------

[[node]]
id    = 8
kind  = "primitive.and_bool"
label = "clutch AND throttle"
x     = 576.0
y     = 108.0
pins  = [
  { id = 0, name = "a",   type = "bool", direction = "input",  unit = "" },
  { id = 1, name = "b",   type = "bool", direction = "input",  unit = "" },
  { id = 2, name = "out", type = "bool", direction = "output", unit = "" }
]

[[node]]
id    = 9
kind  = "primitive.and_bool"
label = "speed AND rpm"
x     = 576.0
y     = 348.0
pins  = [
  { id = 0, name = "a",   type = "bool", direction = "input",  unit = "" },
  { id = 1, name = "b",   type = "bool", direction = "input",  unit = "" },
  { id = 2, name = "out", type = "bool", direction = "output", unit = "" }
]

[[node]]
id    = 10
kind  = "primitive.and_bool"
label = "all four armed"
x     = 840.0
y     = 228.0
pins  = [
  { id = 0, name = "a",   type = "bool", direction = "input",  unit = "" },
  { id = 1, name = "b",   type = "bool", direction = "input",  unit = "" },
  { id = 2, name = "out", type = "bool", direction = "output", unit = "" }
]

# ---- Action ------------------------------------------------------

[[node]]
id    = 11
kind  = "hook.ignition_cut"
label = "Ignition cut"
x     = 1104.0
y     = 228.0
phase_break = true
pins  = [
  { id = 0, name = "Cut active", type = "bool", direction = "input", unit = "" }
]

# Sensor → compare wires
[[edge]]
from_node = 2
from_pin  = 0
to_node   = 5
to_pin    = 0

[[edge]]
from_node = 3
from_pin  = 0
to_node   = 6
to_pin    = 0

[[edge]]
from_node = 4
from_pin  = 0
to_node   = 7
to_pin    = 0

# Compares + clutch → first-level AND
[[edge]]
from_node = 1
from_pin  = 0
to_node   = 8
to_pin    = 0

[[edge]]
from_node = 5
from_pin  = 2
to_node   = 8
to_pin    = 1

[[edge]]
from_node = 6
from_pin  = 2
to_node   = 9
to_pin    = 0

[[edge]]
from_node = 7
from_pin  = 2
to_node   = 9
to_pin    = 1

# First-level ANDs → top AND
[[edge]]
from_node = 8
from_pin  = 2
to_node   = 10
to_pin    = 0

[[edge]]
from_node = 9
from_pin  = 2
to_node   = 10
to_pin    = 1

# Top AND → ignition cut
[[edge]]
from_node = 10
from_pin  = 2
to_node   = 11
to_pin    = 0
