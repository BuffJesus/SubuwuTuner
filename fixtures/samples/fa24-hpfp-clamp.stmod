# FA20→FA24 HPFP commanded-target clamp.
#
# Runtime compensation for the FA24's lower-than-FA20 maximum fuel
# rail pressure. Used when the FA20 ECU's HPFP control PID targets
# pressures the FA24's reduced HPFP cam lobe lift cannot generate,
# causing the pump to run at max duty fighting an unreachable target
# and producing P008x rail-pressure DTCs.
#
# WHEN TO USE THIS PATTERN vs TABLE EDITS:
#
# The simpler fix on a 2017+ VA-WRX FA24 swap is to **rescale the
# HPFP duty + target pressure TABLES in the definition pack** (see
# docs/16 §"Worked example"). That's how Atlas approaches it — by
# exposing the HPFP control tables as editable parameters. EcuTek
# can't do this (those tables are locked in EcuTek); for that case
# (and for any scenario where the table resolution isn't enough),
# the runtime override below is the right tool.
#
# Specifically useful when:
#   - You're integrating an aftermarket CAN-bus fuel pressure sensor
#     and want to clamp the commanded target based on its real-time
#     reading (the pattern Atlas calls "3rd-party sensor integration")
#   - The pressure target needs to depend on RPM × load in a way the
#     stock table grid can't express
#   - You're running a Link standalone-ECU alternative path and need
#     to bridge HPFP control between OEM and standalone domains
#
# WHAT IT DOES:
#
#     clamped_target = min(commanded, MAX_FA24_TARGET_BAR)
#
# implemented as:
#
#     too_high       = commanded > MAX_FA24_TARGET_BAR
#     clamped_target = select(too_high, MAX_FA24_TARGET_BAR, commanded)
#
# Placeholder constant:
#   MAX_FA24_TARGET_BAR = 170.0  ← Nostrum's recommended ceiling for the
#                                  FA24 stock pump (per their product
#                                  page); real values need bench
#                                  characterization or live monitoring.
#
# This is the minimum-viable shape. A more realistic version would
# scale MAX_FA24_TARGET_BAR with RPM (pump output is RPM × stroke ×
# efficiency), but that needs a curve / table-lookup primitive that
# isn't shipped yet (`docs/16` "Not yet implemented" §SH-2A primitives).
#
# Pairs with fixtures/demo-pack (placeholder addresses). Compile with:
#
#   subuwutuner-cli feature-compile fixtures/samples/fa24-hpfp-clamp.stmod \
#     --def fixtures/demo-pack --arch sh2a

[graph]
schema_version = 1

# ---- Splice: read commanded HPFP target ---------------------------

[[node]]
id    = 1
kind  = "hook.override_hpfp_target"
label = "Override HPFP target"
x     = 48.0
y     = 48.0
phase_break = true
pins  = [
  { id = 0, name = "commanded_pressure_bar", label = "Commanded rail pressure", type = "float", direction = "output", unit = "bar" },
  { id = 1, name = "actual_pressure_bar",    label = "Actual rail pressure",    type = "float", direction = "output", unit = "bar" },
  { id = 2, name = "rpm",                    label = "Engine RPM",              type = "float", direction = "output", unit = "rpm" },
  { id = 3, name = "load",                   label = "Engine load",             type = "float", direction = "output", unit = "%"   },
  { id = 4, name = "target_override_bar",    label = "Override target pressure", type = "float", direction = "input",  unit = "bar" },
]

# ---- Compare: commanded > MAX_FA24_TARGET_BAR ---------------------

[[node]]
id    = 2
kind  = "primitive.compare_gt_float"
label = "commanded > 170 bar"
x     = 288.0
y     = 48.0
pins  = [
  { id = 0, name = "a",     type = "float", direction = "input",  unit = "bar" },
  { id = 1, name = "b",     type = "float", direction = "input",  unit = "bar", default = 170.0 },
  { id = 2, name = "a > b", type = "bool",  direction = "output", unit = "" },
]

# ---- Select: too_high ? MAX_FA24_TARGET_BAR : commanded -----------

[[node]]
id    = 3
kind  = "primitive.select_float"
label = "clamp to 170 bar"
x     = 528.0
y     = 48.0
pins  = [
  { id = 0, name = "cond",   type = "bool",  direction = "input",  unit = "" },
  { id = 1, name = "if_yes", type = "float", direction = "input",  unit = "bar", default = 170.0 },
  { id = 2, name = "if_no",  type = "float", direction = "input",  unit = "bar" },
  { id = 3, name = "out",    type = "float", direction = "output", unit = "bar" },
]

# ---- Edges --------------------------------------------------------

# commanded_pressure_bar → compare.a
[[edge]]
from_node = 1
from_pin  = 0
to_node   = 2
to_pin    = 0

# compare.out → select.cond
[[edge]]
from_node = 2
from_pin  = 2
to_node   = 3
to_pin    = 0

# commanded_pressure_bar → select.if_no
[[edge]]
from_node = 1
from_pin  = 0
to_node   = 3
to_pin    = 2

# select.out → hook.target_override_bar
[[edge]]
from_node = 3
from_pin  = 3
to_node   = 1
to_pin    = 4
